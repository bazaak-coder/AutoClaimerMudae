#!/bin/sh
# post-commit: send the commit message of the new HEAD to the Discord webhook.
# The webhook URL is read from webhook.url at the repository root (gitignored).
# Never hardcode the URL here or anywhere tracked by git.
set -eu

root=$(git rev-parse --show-toplevel)
[ -f "$root/webhook.url" ] || exit 0
url=$(tr -d ' \t\n' < "$root/webhook.url")
[ -n "$url" ] || exit 0

short=$(git rev-parse --short HEAD)
branch=$(git rev-parse --abbrev-ref HEAD)
author=$(git log -1 --pretty=%an)
msg=$(git log -1 --pretty=%B)

payload=$(python3 - "$author" "$branch" "$short" "$msg" <<'PYEOF'
import json
import sys

author, branch, short, msg = sys.argv[1:5]
msg = msg.strip() or "(no commit message)"
if len(msg) > 1800:
    msg = msg[:1797] + "..."
payload = {
    "username": "AutoClaimer",
    "embeds": [
        {
            "title": f"Commit {short} on {branch}",
            "description": msg,
            "color": 3447003,
            "footer": {"text": f"local commit by {author}"},
        }
    ],
}
print(json.dumps(payload))
PYEOF
)

curl -sS -o /dev/null -H 'Content-Type: application/json' -X POST -d "$payload" "$url" || exit 0
